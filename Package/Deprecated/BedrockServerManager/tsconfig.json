{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "rootDir": "Source",
    "outDir": "Distribution",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": false,
    "types": [
      "node"
    ],
    "declaration": true
  },
  "include": [
    "Source/**/*.ts",
    "Source/**/*.tsx"
  ]
}
