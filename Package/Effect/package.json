  "name": "@bedform/effect",
  "version": "1.0.0-alpha.1",
  "description": "A self-contained port of Effect utilities for Bedrock Dedicated Server.",
  "main": "./Distribution/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint Source",
    "lint:function": "eslint Source/Function.ts Test/Function*.mts",
    "test:function": "npm run build && node --import tsx --test Test/Function.test.mts",
    "lint:data": "eslint Source/Data.ts Test/Data*.mts Test/UpstreamWeb.d.mts",
    "test:data": "npm run build && node --import tsx --test Test/Data.test.mts",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "test:schema:foundation": "npm run build && node --import tsx --test Test/SchemaCompatibility.test.mts Test/SchemaDependencies.test.mts",
    "lint:schema:foundation": "eslint Source/BigDecimal.ts Source/BigInt.ts Source/ByteSize.ts Source/Chunk.ts Source/Duration.ts Source/HashMap.ts Source/HashSet.ts Source/NonEmptyIterable.ts Source/Redacted.ts Source/RegExp.ts Source/Internal/hashMap.ts Source/Internal/hashSet.ts Source/Internal/redacted.ts Source/Internal/brand.ts Source/Internal/utf8.ts Source/Encoding/Base64.ts Source/Encoding/Base64Url.ts Source/Encoding/Hex.ts Source/Encoding/EncodingError.ts Test/Schema*.mts Tool/SchemaManifest.mts",
    "manifest:schema": "node --import tsx Tool/SchemaManifest.mts",
    "test:schema": "npm run build && node --import tsx --test Test/Schema*.test.mts",
    "lint:schema": "npm run lint:schema:foundation && eslint Source/Schema*.ts Source/StandardSchema.ts Source/JsonSchema.ts Source/JsonPointer.ts Source/Internal/Schema Source/Internal/schemaError.ts Source/Internal/errors.ts Source/Internal/brand.ts Test/Schema*.mts",
    "verify:schema": "npm run typecheck && npm run typecheck:tools && npm run test:schema && npm run lint:schema && npm run test:function && npm run test:data",
    "lint:brand": "eslint Source/Brand.ts Source/Internal/brand.ts Test/Brand*.mts",
    "test:brand": "npm run build && node --import tsx --test Test/Brand.test.mts",
    "verify:brand": "npm run typecheck && npm run build && npm run typecheck:tools && npm run lint:brand && npm run test:brand && npm run test:schema",
    "lint:match": "eslint Source/Match.ts Source/Internal/matcher.ts Test/Match*.mts",
    "test:match": "npm run build && node --import tsx --test Test/Match.test.mts",
    "verify:match": "npm run typecheck && npm run build && npm run typecheck:tools && npm run lint:match && npm run test:match && npm run test:function && npm run test:data && npm run test:brand",
    "lint:collections": "eslint Source/Array.ts Source/Record.ts Source/Struct.ts Source/Number.ts Source/Tuple.ts Test/Collections*.mts",
    "test:collections": "npm run build && node --import tsx --test Test/Collections*.test.mts",
    "verify:collections": "npm run typecheck && npm run build && npm run typecheck:tools && npm run lint:collections && npm run test:collections && npm run test:function && npm run test:data && npm run test:match && npm run test:brand && npm run test:schema",
    "lint:number": "eslint Source/Number.ts Test/Number*.mts",
    "test:number": "npm run build && node --import tsx --test Test/Number.test.mts",
    "verify:number": "npm run typecheck && npm run build && npm run typecheck:tools && npm run lint:number && npm run test:number && npm run test:collections",
    "lint:protocols": "eslint Source/index.ts Test/Protocols*.mts",
    "test:protocols": "npm run build && node --import tsx --test Test/Protocols.test.mts",
    "verify:protocols": "npm run typecheck && npm run build && npm run typecheck:tools && npm run lint:protocols && npm run test:protocols && npm run test:number && npm run test:collections",
    "lint:unit": "eslint Source/Unit.ts Source/Unit Test/Unit*.mts",
    "test:unit": "npm run build && node --import tsx --test Test/Unit*.test.mts",
    "verify:unit": "npm run typecheck && npm run build && npm run typecheck:tools && npm run lint:numeric && npm run lint:unit && npm run test:numeric && npm run test:unit && npm run test:schema",
    "lint:numeric": "eslint Source/Int.ts Source/UInt.ts Source/Rational.ts Source/BigRational.ts Source/Internal/valueObject.ts Test/Int*.mts Test/Rational*.mts",
    "test:numeric": "npm run build && node --import tsx --test Test/Int.test.mts Test/Rational.test.mts",
    "verify:numeric": "npm run typecheck && npm run build && npm run typecheck:tools && npm run lint:numeric && npm run test:numeric",
    "lint:runtime": "eslint Source/Cause.ts Source/Clock.ts Source/Context.ts Source/Cron.ts Source/Deferred.ts Source/Effect.ts Source/Effectable.ts Source/ExecutionPlan.ts Source/Exit.ts Source/Fiber.ts Source/Filter.ts Source/Layer.ts Source/ManagedRuntime.ts Source/Metric.ts Source/MutableHashMap.ts Source/MutableRef.ts Source/Pull.ts Source/Redactable.ts Source/Ref.ts Source/Request.ts Source/Schedule.ts Source/Scheduler.ts Source/Scope.ts Source/Tracer.ts Source/References.ts Source/Internal/core.ts Source/Internal/dateTime.ts Source/Internal/effect.ts Source/Internal/executionPlan.ts Source/Internal/layer.ts Source/Internal/metric.ts Source/Internal/random.ts Source/Internal/references.ts Source/Internal/request.ts Source/Internal/schedule.ts Source/Internal/tracer.ts Source/LogLevel.ts Source/Console.ts Source/Latch.ts Source/Random.ts Source/ErrorReporter.ts Source/TxRef.ts Source/Internal/dateTime-types.ts Source/Internal/logger-types.ts Source/Internal/requestResolver-types.ts Source/Internal/stream-types.ts Source/Internal/channel-types.ts Source/Internal/host.ts Source/Internal/abort.ts Source/Bedrock.ts Test/Runtime.test.mts Test/Bedrock.test.mts Tool/bds-runtime.mts Tool/BdsFixture/main.mts Tool/BdsFixture/keys.mts",
    "test:runtime": "npm run build && node --import tsx --test Test/Runtime.test.mts Test/Bedrock.test.mts",
    "verify:runtime": "npm run typecheck && npm run build && npm run typecheck:tools && npm run lint:runtime && npm run test:runtime && npm run test:data && npm run test:schema && npm run test:match && npm run test:collections",
    "test:bds": "node --import tsx Tool/bds-runtime.mts",
    "test:primitives": "npm run build && node --import tsx --test Test/Primitives*.test.mts",
    "lint:primitives": "eslint Source/Predicate.ts Source/String.ts Test/Primitives*.mts",
    "verify:primitives": "npm run typecheck && npm run typecheck:tools && npm run lint:function && npm run lint:primitives && npm run test:function && npm run test:primitives",
    "test:host": "npm run build && node --import tsx --test --test-concurrency=2 Test/*.test.mts"
