      "loop": true,
      "bones": {
        "root": {
          "rotation": [
            0,
            "-query.body_y_rotation",
            0
          ]
        },
        "offset": {
          "position": [
            "query.property('bedform:diagetic_offset_x')",
            "query.property('bedform:diagetic_offset_y')",
            "query.property('bedform:diagetic_offset_z')"
          ]
        },
        "mount_yaw": {
          "rotation": [
