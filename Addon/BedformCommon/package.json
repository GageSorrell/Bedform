{
  "name": "bedform-common",
  "version": "1.1.3",
  "description": "Shared behavior and resource pack foundation for Bedform add-ons.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --import tsx Tool/Build.mts",
    "mcaddon": "npm run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "lint": "eslint Script Tool Test --max-warnings 0",
    "test": "node --import tsx --test Test/*.test.mts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "fflate": "0.8.2"
  }
}
