{
  "name": "@sorrell/world-input-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@bedform/server": "2.11.0-beta.1"
  },
  "scripts": {
    "build": "node --import tsx Tool/Build.mts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "lint": "eslint Script Tool Test --max-warnings 0",
    "test": "node --import tsx --test Test/*.test.mts",
    "demo:prepare": "node --import tsx Tool/Demonstration.mts",
    "demo:world-input": "node --import tsx \"../../Script/Deprecated/Demonstration/Source/start.mts\" --server \"Demonstration/world-input/server\""
  }
}
