{
    "editor.codeActionsOnSave": {},
    "eslint.options": {
        "overrideConfigFile": "./eslint.config.ts"
    },
    "eslint.enable": true,
    "eslint.nodePath": "node_modules",
    "eslint.codeActionsOnSave.rules": null,
    "editor.formatOnSave": false,
    "eslint.format.enable": false,
    "explorer.excludeGitIgnore": false,
    "eslint.workingDirectories": [
        {
            "!cwd": false,
            "directory": "**"
        }
    ],
    "eslint.validate": [
        "javascript",
        "typescript"
    ],
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.useDefaultExcludes": true,
    "python.analysis.exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/.git",
        "**/dist",
        "**/Distribution",
        "**/Intermediate",
        "Reference"
    ],
    "search.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/dist": true,
        "**/lib": true
    },
    "files.exclude": {
        "**/.git": true,
        "**/.DS_Store": true,
        "**/node_modules": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.jj": true,
        "**/Thumbs.db": true
    },
